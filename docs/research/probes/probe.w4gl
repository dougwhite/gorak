[proc4glsource]
datatype = "integer"

===

PROCEDURE probe() =
DECLARE
    s = StringObject;
    b = BitmapObject;
    status = integer;
ENDDECLARE
{
    s.Value = 'Gorak shared storage probe';
    status = s.InsertIntoDB();
    IF status != 0 THEN ROLLBACK; RETURN 11; ENDIF;
    COMMIT;
    s.Value = 'Gorak shared storage updated';
    status = s.UpdateInDB();
    IF status != 0 THEN ROLLBACK; RETURN 12; ENDIF;
    COMMIT;
    status = s.DeleteFromDB();
    IF status != 0 THEN ROLLBACK; RETURN 13; ENDIF;
    COMMIT;
    s.Value = 'Gorak explicit nstring storage';
    status = s.InsertIntoDB(tablename='ii_stored_nstrings');
    IF status != 0 THEN ROLLBACK; RETURN 31; ENDIF;
    COMMIT;
    s.Value = 'Gorak explicit nstring updated';
    status = s.UpdateInDB();
    IF status != 0 THEN ROLLBACK; RETURN 32; ENDIF;
    COMMIT;
    status = s.DeleteFromDB();
    IF status != 0 THEN ROLLBACK; RETURN 33; ENDIF;
    COMMIT;
    b.BlankBitmap(width=8,height=8,color=1);
    status = b.InsertIntoDB();
    IF status != 0 THEN ROLLBACK; RETURN 21; ENDIF;
    COMMIT;
    b.SetPixelColor(x=1,y=1,color=2);
    status = b.UpdateInDB();
    IF status != 0 THEN ROLLBACK; RETURN 22; ENDIF;
    COMMIT;
    status = b.DeleteFromDB();
    IF status != 0 THEN ROLLBACK; RETURN 23; ENDIF;
    COMMIT;
    RETURN 0;
}
