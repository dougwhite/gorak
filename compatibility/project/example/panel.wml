<frame>
  <topform width="6000" height="3000">
    <entryfield name="quantity" xleft="200" ytop="200" width="1400" height="300" datatype="integer" fieldstyle="0">
      <defaultstring>before<?ingres_invalidxmlchar 7?>after</defaultstring>
    </entryfield>
    <buttonfield name="calculate" xleft="200" ytop="700" width="1400" height="300" bgcolor="6" textlabel="Calculate" fieldstyle="1">
      <script><![CDATA[on click =
{
    quantity = CALLPROC score(capsules = quantity);
}]]></script>
    </buttonfield>
    <tablefield name="results" xleft="2000" ytop="200" width="3000" height="2000" fieldstyle="0">
      <tablebody>
        <columnfield name="amount">
          <protofield type="entryfield" name="amount" datatype="integer" width="1000" fieldstyle="0"/>
        </columnfield>
      </tablebody>
    </tablefield>
  </topform>
</frame>
