<frame>
  <topform width="6000" height="3000">
    <bgbitmap src="images/badge.png" path="art/badge.png" native-t7="1" native-t8="7"/>
    <entryfield name="quantity" xleft="200" ytop="200" width="1400" height="300" datatype="integer" fieldstyle="0">
      <cursor syscursor="1"/>
      <defaultstring>before<?ingres_invalidxmlchar 7?>after</defaultstring>
    </entryfield>
    <entryfield name="nullable_default" datatype="integer" isnullable="1" defaultvalue="2"/>
    <entryfield name="specified_default" datatype="integer" defaultvalue="3" defaultstring="7"/>
    <buttonfield name="calculate" xleft="200" ytop="700" width="1400" height="300" bgcolor="6" textlabel="Calculate" fieldstyle="1">
      <script><![CDATA[on click =
{
    quantity = CALLPROC score(capsules = quantity);
}]]></script>
    </buttonfield>
    <tablefield name="results" xleft="2000" ytop="200" width="3000" height="2000" fieldstyle="0">
      <tablebody>
        <columnfield name="amount">
          <protofield type="entryfield" name="amount" datatype="integer" width="1000" fieldstyle="0"/>
        </columnfield>
      </tablebody>
    </tablefield>
    <viewportfield name="preview" xleft="200" ytop="2300" width="1400" height="500" fieldstyle="0">
      <viewfield type="flexibleform" name="content" width="1400" height="500" ismovebounded="0"/>
    </viewportfield>
  </topform>
  <mainbartop name="top_1">
    <buttonfield name="top_action_1" textlabel="Top 1"/>
  </mainbartop>
  <mainbartop name="top_2">
    <buttonfield name="top_action_2" textlabel="Top 2"/>
  </mainbartop>
  <mainbarbottom name="bottom_1">
    <buttonfield name="bottom_action_1" textlabel="Bottom 1"/>
  </mainbarbottom>
  <mainbarbottom name="bottom_2">
    <buttonfield name="bottom_action_2" textlabel="Bottom 2"/>
  </mainbarbottom>
  <mainbarleft name="left_1">
    <buttonfield name="left_action_1" textlabel="Left 1"/>
  </mainbarleft>
  <mainbarleft name="left_2">
    <buttonfield name="left_action_2" textlabel="Left 2"/>
  </mainbarleft>
  <mainbarright name="right_1">
    <buttonfield name="right_action_1" textlabel="Right 1"/>
  </mainbarright>
  <mainbarright name="right_2">
    <buttonfield name="right_action_2" textlabel="Right 2"/>
  </mainbarright>
</frame>
